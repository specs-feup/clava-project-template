{
    "name": "@specs-feup/clava-project-template",
    "version": "1.1.0",
    "author": "L. Sousa",
    "description": "A template for developing projects for Clava in Typescript",
    "type": "module",
    "files": [
      "api",
      "src",
      ".gitignore",
      "jest.config.js",
      "LICENSE",
      "package-lock.json",
      "package.json",
      "README.md",
      "tsconfig.jest.json",
      "tsconfig.json",
      "typedoc.config.js"
    ],     
    "scripts": {
        "run": "clava classic dist/main.js -p CxxSources/",
        "run:watch": "clava dist/main.js -w dist/main.js -- clang CxxSources/",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "lint": "eslint .",
        "docs": "typedoc",
        "test": "cross-env NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest --detectOpenHandles --forceExit src",
        "test:cov": "node --run test -- --coverage",
        "test:watch": "node --run test -- --watch"
    },
    "dependencies": {
        "@specs-feup/clava": "~3.5.0"
    },
    "devDependencies": {
        "@jest/globals": "^30.2.0",
        "@types/jest": "^30.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jest": "^29.12.1",
        "eslint-plugin-tsdoc": "^0.5.0",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "typedoc": "^0.28.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.52.0"
    }
}
